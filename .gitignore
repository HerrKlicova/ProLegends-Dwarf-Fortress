# --- Secretos: NUNCA subir la clave de API ---
.env
.env.local
*.key

# --- Entornos virtuales de Python ---
venv/
.venv/
env/
ENV/

# --- Cache de Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Crónicas generadas por IA ---
# No se suben: son tuyas y hablan de tus partidas. Viven en tu ordenador, en
# data/cronicas/, y ahí no las borra nada. Si algún día quieres respaldarlas en
# GitHub, se pueden añadir a mano con 'git add -f data/cronicas'.
data/cronicas/

# --- Ajustes locales de esta máquina ---
# Dónde tienes instalado Dwarf Fortress y cosas así: solo valen en tu ordenador.
# Desde la 1.3.1 esto vive en Documentos/ProLegends, fuera del repositorio; la
# regla se queda por si queda algo de una versión anterior.
data/ajustes.json

# --- Base de datos generada (se regenera importando) ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/db/

# --- Exports de legends (pesan decenas de MB, no van al repo) ---
data/imports/**/*.xml
data/imports/**/*.zip
data/imports/**/*.bmp
data/imports/**/*.png
data/imports/**/*.txt
data/imports/*.xml
data/imports/*.zip
data/imports/*.bmp
data/imports/*.png
data/imports/*.txt
!data/imports/.gitkeep

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- Logs y temporales ---
*.log
tmp/
.cache/
