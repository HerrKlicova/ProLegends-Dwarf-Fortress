env/
ENV/

# --- Cache de Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Crónicas generadas por IA ---
# NO se ignoran a propósito: son lo único que cuesta dinero y no se puede
# regenerar gratis, así que si algún día subes la carpeta quedan respaldadas.
# Si prefieres que no salgan de tu ordenador, quita la almohadilla de la
# línea siguiente.
# data/cronicas/

# --- Base de datos generada (se regenera importando) ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/db/

# --- Exports de legends (pesan decenas de MB, no van al repo) ---
data/imports/**/*.xml
data/imports/**/*.zip
data/imports/**/*.bmp
data/imports/**/*.png
data/imports/**/*.txt
data/imports/*.xml
data/imports/*.zip
data/imports/*.bmp
data/imports/*.png
data/imports/*.txt
