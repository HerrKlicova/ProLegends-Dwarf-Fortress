# Copia este fichero como .env y rellena tu clave.
# El fichero .env NO se sube nunca al repositorio (esta en .gitignore).

# Clave de la API de Anthropic, necesaria solo para las cronicas narradas.
# Se saca de https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo que redacta las cronicas. Para narrar texto no hace falta mas.
ANTHROPIC_MODEL=claude-sonnet-5

# Longitud maxima de cada cronica, en tokens.
ANTHROPIC_MAX_TOKENS=4000

# Puerto del servidor local y direccion de escucha.
PROLEGENDS_PORT=8420
PROLEGENDS_HOST=127.0.0.1

# Radio en casillas para los avisos de "hay algo hostil cerca de mi fortaleza".
PROLEGENDS_ALERT_RADIUS=20
