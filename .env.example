# ---------------------------------------------------------------------
#  ESTE FICHERO ES SOLO UN EJEMPLO. No lo edites.
#
#  Al arrancar start.bat se crea una copia llamada .env (sin ".example").
#  ESA copia es la tuya: es la que tienes que abrir con el Bloc de notas
#  y rellenar. El .env nunca se sube al repositorio, así que tu clave se
#  queda en tu ordenador.
# ---------------------------------------------------------------------

# Tu clave de la API de Anthropic. Solo hace falta para las crónicas
# narradas; todo lo demás funciona sin ella.
#
# Se saca de https://console.anthropic.com/settings/keys
# Es una cadena larga que empieza por "sk-ant-". Pégala justo detrás del
# igual, sin espacios y sin comillas. Quedaría así:
#
#     ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
#
ANTHROPIC_API_KEY=

# Modelo que redacta las crónicas. Para narrar texto no hace falta más.
ANTHROPIC_MODEL=claude-sonnet-5

# Longitud máxima de cada crónica, en tokens.
ANTHROPIC_MAX_TOKENS=4000

# Puerto del servidor local y dirección de escucha.
PROLEGENDS_PORT=8420
PROLEGENDS_HOST=127.0.0.1

# Radio en casillas para los avisos de "hay algo hostil cerca de mi fortaleza".
PROLEGENDS_ALERT_RADIUS=20
